# ==============================================================================
# SayyafAC (صَيّاف للتكييف) - Apache / LiteSpeed Configuration
# 301 Permanent Redirects and Performance Headers
# ==============================================================================

RewriteEngine On

# 1. 301 Redirect for legacy /installation/ path
RewriteRule ^installation/?$ /split-ac-installation-technician/ [R=301,L]

# 2. Enforce Trailing Slash on Directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 3. Security & MIME types for WOFF2 & SVG
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>
